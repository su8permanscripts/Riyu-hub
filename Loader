-- Hover Effect
local function addHover(btn, baseColor)
    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = baseColor:lerp(Color3.fromRGB(255,255,255), 0.2)}):Play()
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = baseColor}):Play()
    end)
end

addHover(timebombButton, timebombButton.BackgroundColor3)
addHover(mmButton, mmButton.BackgroundColor3)

-- Snowflakes
local function createSnowflake()
    local flake = Instance.new("ImageLabel")
    flake.Size = UDim2.new(0, math.random(8, 20), 0, math.random(8, 20))
    flake.Position = UDim2.new(math.random(), 0, -0.1, 0)
    flake.BackgroundTransparency = 1
    flake.Image = "rbxassetid://6031097228"
    flake.ImageColor3 = Color3.fromRGB(180, 210, 255)
    flake.ImageTransparency = math.random(30, 70)/100
    flake.ZIndex = 1
    flake.Parent = snowContainer
    
    local duration = math.random(7, 13)
    local tween = TweenService:Create(flake, TweenInfo.new(duration, Enum.EasingStyle.Linear), {
        Position = UDim2.new(flake.Position.X.Scale + math.random(-60,60)/400, 0, 1.1, 0),
        Rotation = math.random(-180, 180)
    })
    tween:Play()
    tween.Completed:Connect(function() flake:Destroy() end)
end

RunService.Heartbeat:Connect(function()
    if math.random(1, 3) == 1 then
        createSnowflake()
    end
end)

